# Copy the NAMES below into .env.local (never commit .env.local) and into Vercel > Settings > Environment Variables.
# Do not put real values in this file.

# Neon connection string. Easiest: `vercel env pull .env.local` fills this in for you.
DATABASE_URL=

# Secret used to sign login sessions. Generate one with:  npx auth secret
AUTH_SECRET=

# Optional: your production address, used for metadata (Open Graph) links.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
